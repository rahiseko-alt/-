{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${CLAUDE_CODE_REMOTE:-}\" = \"true\" ] && bash \"$CLAUDE_PROJECT_DIR/system/scripts/setup.sh\" --quiet || true",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
