{
  "name": "publishing-studio",
  "version": "0.1.0",
  "private": true,
  "description": "AI支援型DTP制作システム（AIビジネス専門学校）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config system/design-engine/vite.config.ts",
    "render": "tsx system/scripts/render.ts",
    "compare": "tsx system/scripts/compare.ts",
    "validate": "tsx system/scripts/validate.ts",
    "new:book": "tsx system/scripts/new-book.ts",
    "new:page": "tsx system/scripts/new-page.ts",
    "ref:ingest": "tsx system/scripts/ingest-reference.ts",
    "ref:prep": "tsx system/scripts/ref-prep.ts",
    "gen:inputs": "tsx system/scripts/gen-inputs.ts",
    "photo:add": "tsx system/scripts/photo-add.ts",
    "doctor": "tsx system/scripts/doctor.ts",
    "setup": "bash system/scripts/setup.sh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run validate && npm run test"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "fast-glob": "^3.3.3",
    "handlebars": "^4.7.10",
    "pixelmatch": "^8.0.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
